@namespace Klyroo.Table
@inherits KlyToolsComponentBase

@* The question an action asks before it runs. Cancel and the confirm button close the dialog without a round trip (data-kly-close); the confirm button also runs the action. *@
<KlyModal Open="Open" OpenChanged="OpenChanged" Title="@Title" Description="@Description" data-slot="action-dialog">
    <Footer>
        <KlyButton Label="@ToolsMessages.ActionCancel" Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" data-kly-close data-slot="action-cancel" />
        <KlyButton Label="@ConfirmLabel" Color="Color" OnClick="OnConfirm" data-kly-close data-slot="action-confirm" />
    </Footer>
</KlyModal>

@code {
    /// <summary>Whether the dialog is open. Bind it with <c>@bind-Open</c>.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Raised when the dialog opens or closes.</summary>
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>The title of the dialog.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The text under the title. Nothing is shown without it.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>The label of the confirm button.</summary>
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = "";

    /// <summary>The color of the confirm button; <see cref="KlyColor.Error"/> for a destructive action.</summary>
    [Parameter] public KlyColor Color { get; set; }

    /// <summary>Raised when the confirm button is clicked, after which the dialog closes.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
}
