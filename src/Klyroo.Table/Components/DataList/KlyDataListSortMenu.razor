@namespace Klyroo.Table
@typeparam TItem
@inherits DataListPartBase<TItem>
@using Klyroo.Query

@*
    Sort menu: picks the sort field, its direction (ascending or descending), or restores the default sort order.
    Essential in Grid layout (where there are no table column headers) and on small screens, and usable in any toolbar.
    Works in every render mode: in static rendering the popover opens via the native Popover API and the choices inside are links (?s=...).
*@
@if (ShouldShow)
{
    var options = Context.SortOptions(Items);
    if (options.Count > 0)
    {
        var active = Context.EffectiveSort is { Count: > 0 } s ? s[0] : null;
        var activeOption = active is null ? null : options.FirstOrDefault(o => string.Equals(o.Key, active.Key, StringComparison.Ordinal));
        var activeLabel = activeOption?.Label ?? (active is not null ? DataListText.Humanize(active.Key) : null);
        var descending = active?.Descending ?? false;
        var targetKey = active?.Key ?? options[0].Key;
        var isDefault = Context.IsDefaultSort(Context.State);
        var sorts = Context.EffectiveSort;
        var editor = Multiple ?? sorts.Count > 1;
        var triggerText = sorts.Count > 1 && editor
            ? (Label is not null ? $"{Label}: {string.Format(FormatCulture, ToolsMessages.SortMultiple, sorts.Count)}" : string.Format(FormatCulture, ToolsMessages.SortMultiple, sorts.Count))
            : activeLabel is not null
                ? (Label is not null ? $"{Label}: {activeLabel}" : string.Format(FormatCulture, ToolsMessages.SortBy, activeLabel))
                : (Label ?? ToolsMessages.Sort);
        var triggerIcon = active is null || (editor && sorts.Count > 1) ? "arrow-up-down" : descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp;

        <div class="@_slots["sortMenu"]" data-slot="sort-menu" @attributes="AdditionalAttributes">
            <KlyPopover Placement="bottom-end" Ui="_popoverUi">
                <ChildContent>
                    <KlyButton Variant="ButtonVariant.Outline" Color="KlyColor.Neutral" Size="Size"
                              Label="@triggerText" LeadingIcon="@RenderIcon(triggerIcon, "size-4")" data-slot="sort-trigger" />
                </ChildContent>
                <Content>
                    <div class="@_slots["sortMenuContent"]" data-slot="sort-content">
                        <div class="@_slots["sortMenuHeader"]">
                            <p class="@_slots["sortMenuTitle"]">@(Label ?? ToolsMessages.Sort)</p>
                            @if (Context.IsInteractive)
                            {
                                <KlyButton Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" Size="KlySize.Xs"
                                          Label="@ToolsMessages.SortDefault" Disabled="@isDefault"
                                          OnClick="@(() => Context.SetState(Context.ClearSort, QueryHistory.Push))" data-slot="sort-reset" />
                            }
                            else if (!isDefault && Context.CanLink && Context.HrefWith(Context.ClearSort) is { } resetHref)
                            {
                                <KlyButton Variant="ButtonVariant.Ghost" Color="KlyColor.Neutral" Size="KlySize.Xs"
                                          Label="@ToolsMessages.SortDefault" Href="@resetHref" data-slot="sort-reset" />
                            }
                        </div>
                        @if (editor)
                        {
                            @Editor(options, sorts)
                        }
                        else
                        {
                        <div class="@_slots["sortMenuDirections"]" role="group" aria-label="@(Label ?? ToolsMessages.Sort)" data-slot="sort-directions">
                            @DirectionControl(targetKey, isDescending: false, active is not null && !descending, ToolsMessages.SortDirectionAscending, Options.Icons.ArrowUp, "asc")
                            @DirectionControl(targetKey, isDescending: true, active is not null && descending, ToolsMessages.SortDirectionDescending, Options.Icons.ArrowDown, "desc")
                        </div>
                        <ul class="@_slots["sortMenuList"]" data-slot="sort-list">
                            @foreach (var opt in options)
                            {
                                var key = opt.Key;
                                var label = opt.Label ?? DataListText.Humanize(key);
                                var isCurrent = active is not null && string.Equals(active.Key, key, StringComparison.Ordinal);
                                var nextDesc = isCurrent ? !descending : descending;
                                <li>
                                    @if (Context.IsInteractive)
                                    {
                                        <button type="button" class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)"
                                                data-slot="sort-item" data-sort-key="@key"
                                                @onclick="@(() => Context.SetState(s => Context.WithSort(s, key, nextDesc), QueryHistory.Push))">
                                            <span class="truncate">@label</span>
                                            @if (isCurrent)
                                            {
                                                @RenderIcon(descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp, "size-4 shrink-0")
                                            }
                                        </button>
                                    }
                                    else if (Context.CanLink && Context.HrefWith(s => Context.WithSort(s, key, nextDesc)) is { } href)
                                    {
                                        <a href="@href" class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)"
                                           data-slot="sort-item" data-sort-key="@key">
                                            <span class="truncate">@label</span>
                                            @if (isCurrent)
                                            {
                                                @RenderIcon(descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp, "size-4 shrink-0")
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="@_slots["sortMenuItem"]" aria-current="@(isCurrent ? "true" : null)" data-slot="sort-item" data-sort-key="@key">
                                            <span class="truncate">@label</span>
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                        }
                    </div>
                </Content>
            </KlyPopover>
        </div>
    }
}

@code {
    private SlotSet _slots = default!;
    private PopoverUi _popoverUi = new();

    /// <summary>Label of the trigger button and heading of the popover. Defaults to the localized "Sort".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Size of the trigger button (small by default).</summary>
    [Parameter] public KlySize Size { get; set; } = KlySize.Sm;

    /// <summary>
    /// Explicit sortable field options. When <see langword="null"/>, the menu lists the sortable <see cref="KlyDataListColumnBase{TItem}"/>s in user order followed by any other sortable fields of the schema.
    /// </summary>
    [Parameter] public IReadOnlyList<DataListSortOption>? Items { get; set; }

    /// <summary>
    /// Layouts in which the sort menu is shown (for example <c>[DataListLayout.Grid]</c> when the table headers already sort). When <see langword="null"/>, shown in every layout.
    /// </summary>
    [Parameter] public IReadOnlyList<DataListLayout>? Layouts { get; set; }

    /// <summary>
    /// Whether the menu edits a list of sorts: <see langword="true"/> always shows the active sorts in order, with a button to reverse, move and remove each, and the fields that can still be added;
    /// <see langword="false"/> keeps the menu that picks one field and its direction; <see langword="null"/> (the default) is the second until the list sorts by more than one field (a Shift+click on a header),
    /// then the first, so a sort of several keys can always be seen and changed.
    /// </summary>
    [Parameter] public bool? Multiple { get; set; }

    private bool ShouldShow => Layouts is null || Layouts.Contains(Context.EffectiveLayout) || (Context.EffectiveLayout == DataListLayout.Table && Context.SummaryViewActive);

    protected override void OnParametersSet()
    {
        _slots = ResolveSlots(ToolsOptions.DataList, new Dictionary<string, string?>(), Ui, "sortMenu");
        _popoverUi = new PopoverUi { Content = _slots["sortMenuPopover"] };
    }

    private string OptionLabel(IReadOnlyList<DataListSortOption> options, string key) =>
        options.FirstOrDefault(o => string.Equals(o.Key, key, StringComparison.Ordinal))?.Label ?? DataListText.Humanize(key);

    // The editor of a sort of several keys: the active sorts in the order they apply, then the fields that can be added.
    private RenderFragment Editor(IReadOnlyList<DataListSortOption> options, IReadOnlyList<DataListSort> sorts) =>
        @<text>
            @if (sorts.Count > 0)
            {
                <p class="@_slots["sortOrderHeading"]" data-slot="sort-order-heading">@ToolsMessages.SortOrderHeading</p>
                <ol class="@_slots["sortOrderList"]" data-slot="sort-order-list">
                    @for (var i = 0; i < sorts.Count; i++)
                    {
                        var entry = sorts[i];
                        var key = entry.Key;
                        var label = OptionLabel(options, key);
                        var index = i;
                        <li class="@_slots["sortOrderItem"]" data-slot="sort-order-item" data-sort-key="@key" data-direction="@(entry.Descending ? "desc" : "asc")">
                            <span class="@_slots["sortOrderIndex"]" aria-hidden="true">@(i + 1)</span>
                            <span class="truncate">@label</span>
                            <span class="@_slots["sortOrderControls"]">
                                @OrderButton(entry.Descending ? Options.Icons.ArrowDown : Options.Icons.ArrowUp, string.Format(FormatCulture, ToolsMessages.SortReverse, label), "reverse", s => Context.ReverseSort(s, key), disabled: false)
                                @if (Context.IsInteractive)
                                {
                                    @OrderButton("chevron-up", string.Format(FormatCulture, ToolsMessages.SortMoveEarlier, label), "earlier", s => Context.MoveSort(s, key, -1), disabled: index == 0)
                                    @OrderButton("chevron-down", string.Format(FormatCulture, ToolsMessages.SortMoveLater, label), "later", s => Context.MoveSort(s, key, 1), disabled: index == sorts.Count - 1)
                                }
                                @OrderButton(Options.Icons.Close, string.Format(FormatCulture, ToolsMessages.SortRemove, label), "remove", s => Context.RemoveSort(s, key), disabled: false)
                            </span>
                        </li>
                    }
                </ol>
            }
            @{
                var addable = options.Where(o => !sorts.Any(x => string.Equals(x.Key, o.Key, StringComparison.Ordinal))).ToList();
            }
            @if (addable.Count > 0)
            {
                <p class="@_slots["sortOrderHeading"]" data-slot="sort-add-heading">@ToolsMessages.SortAddHeading</p>
                <ul class="@_slots["sortMenuList"]" data-slot="sort-list">
                    @foreach (var opt in addable)
                    {
                        var key = opt.Key;
                        var label = opt.Label ?? DataListText.Humanize(key);
                        <li>
                            @if (Context.IsInteractive)
                            {
                                <button type="button" class="@_slots["sortMenuItem"]" data-slot="sort-item" data-sort-key="@key"
                                        @onclick="@(() => Context.SetState(s => Context.AddSort(s, key), QueryHistory.Push))">
                                    <span class="truncate">@label</span>
                                </button>
                            }
                            else if (Context.CanLink && Context.HrefWith(s => Context.AddSort(s, key)) is { } href)
                            {
                                <a href="@href" class="@_slots["sortMenuItem"]" data-slot="sort-item" data-sort-key="@key">
                                    <span class="truncate">@label</span>
                                </a>
                            }
                        </li>
                    }
                </ul>
            }
        </text>;

    // A button of an entry of the sort order list: a button when interactive, a link in a static render (the reorder buttons are interactive only).
    private RenderFragment OrderButton(string icon, string name, string slot, Func<DataListState, DataListState> change, bool disabled) =>
        @<text>
            @if (Context.IsInteractive)
            {
                <button type="button" class="@_slots["sortOrderButton"]" aria-label="@name" title="@name" disabled="@disabled" data-slot="sort-order-@slot"
                        @onclick="@(() => Context.SetState(change, QueryHistory.Push))">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                </button>
            }
            else if (Context.CanLink && Context.HrefWith(change) is { } href)
            {
                <a href="@href" class="@_slots["sortOrderButton"]" aria-label="@name" title="@name" data-slot="sort-order-@slot">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                </a>
            }
        </text>;

    private RenderFragment DirectionControl(string targetKey, bool isDescending, bool isActive, string text, string icon, string slotDir) =>
        @<text>
            @if (Context.IsInteractive)
            {
                <button type="button" class="@_slots["sortMenuDirection"]" aria-pressed="@(isActive ? "true" : "false")"
                        data-slot="sort-direction" data-direction="@slotDir"
                        @onclick="@(() => Context.SetState(s => Context.WithSort(s, targetKey, isDescending), QueryHistory.Push))">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                    <span>@text</span>
                </button>
            }
            else if (Context.CanLink && Context.HrefWith(s => Context.WithSort(s, targetKey, isDescending)) is { } href)
            {
                <a href="@href" class="@_slots["sortMenuDirection"]" aria-current="@(isActive ? "true" : null)"
                   data-slot="sort-direction" data-direction="@slotDir">
                    @RenderIcon(icon, "size-3.5 shrink-0")
                    <span>@text</span>
                </a>
            }
        </text>;
}
