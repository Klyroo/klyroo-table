<Project>
  <!--
    Klyroo.Table has no precompiled stylesheet: a second sheet loaded after klyroo.css would repeat base utilities in its own @layer utilities and
    override the responsive and dark variants of Klyroo.UI. It needs Tailwind compiled by the app.

    With <KlyrooTailwind>true</KlyrooTailwind> nothing else is needed: this file copies the classes the Tools components use (one @source inline(...))
    to obj/klyroo/klyroo-tools.theme.css and sets KlyrooToolsPresent, and the generated Tailwind entry of Klyroo.UI imports that theme.

    With the app's own Tailwind (Node or another pipeline), import the theme after the Klyroo one and say so with KlyrooToolsOwnTailwind=true in the project
    that references this package (KLYTOOLS001 warns there, and in a project with Node Tailwind; a project that merely reaches the package through another one is left alone):

      @import "tailwindcss";
      @import "../obj/klyroo/klyroo.theme.css";
      @import "../obj/klyroo/klyroo-tools.theme.css";
  -->
  <PropertyGroup>
    <KlyrooToolsPresent>true</KlyrooToolsPresent>
  </PropertyGroup>

  <Target Name="KlyrooToolsCopyTailwindTheme" BeforeTargets="BeforeBuild">
    <!-- Klyroo.UI's generated Tailwind entry imports obj/klyroo/klyroo-tools.theme.css when KlyrooToolsPresent is set. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../staticwebassets/klyroo-table.theme.css"
          DestinationFiles="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), klyroo))klyroo-tools.theme.css"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    The check is for the projects that need the classes of the Tools components: the ones with a PackageReference to Klyroo.Table, where the pages
    that use the components are, and the ones that compile Tailwind with Node (a package.json with a "tailwindcss" or "@tailwindcss/..." dependency
    key: a plugin such as prettier-plugin-tailwindcss does not count), whatever they reference. A host that only reaches the package through the
    project that references it has no components of its own and compiles no Tailwind: it has nothing to say there, so it needs no property.
    Not caught: a host that compiles Tailwind another way (not Node, not KlyrooTailwind) and only reaches the package through another project.
  -->
  <Target Name="KlyrooToolsCheckTailwind" BeforeTargets="BeforeBuild" Condition="'$(KlyrooTailwind)' != 'true' And '$(KlyrooToolsOwnTailwind)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_KlyrooToolsReferenced Condition="'@(PackageReference->WithMetadataValue('Identity', 'Klyroo.Table'))' != ''">true</_KlyrooToolsReferenced>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/package.json')">
      <_KlyrooToolsNodeTailwind Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/package.json')), '&quot;(tailwindcss|@tailwindcss/[^&quot;]+)&quot;\s*:'))">true</_KlyrooToolsNodeTailwind>
    </PropertyGroup>
    <Warning Condition="'$(_KlyrooToolsReferenced)' == 'true' Or '$(_KlyrooToolsNodeTailwind)' == 'true'"
             Code="KLYTOOLS001"
             Text="$(MSBuildProjectName) uses Klyroo.Table, which has no precompiled stylesheet and needs Tailwind compiled by the app. Set &lt;KlyrooTailwind&gt;true&lt;/KlyrooTailwind&gt; (Node-free build, nothing else to do), or, if the app compiles Tailwind itself, import obj/klyroo/klyroo-tools.theme.css after obj/klyroo/klyroo.theme.css in your stylesheet and set &lt;KlyrooToolsOwnTailwind&gt;true&lt;/KlyrooToolsOwnTailwind&gt; to silence this warning." />
  </Target>
</Project>
