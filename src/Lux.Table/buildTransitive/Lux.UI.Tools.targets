<Project>
  <!--
    Lux.Table has no precompiled stylesheet: a second sheet loaded after lux.css would repeat base utilities in its own @layer utilities and
    override the responsive and dark variants of Lux.UI. It needs Tailwind compiled by the app.

    With <LuxTailwind>true</LuxTailwind> nothing else is needed: this file copies the classes the Tools components use (one @source inline(...))
    to obj/lux/lux-table.theme.css and sets LuxToolsPresent, and the generated Tailwind entry of Lux.UI imports that theme.

    With the app's own Tailwind (Node or another pipeline), import the theme after the Lux one and say so with LuxToolsOwnTailwind=true in the project
    that references this package (LUXTOOLS001 warns there, and in a project with Node Tailwind; a project that merely reaches the package through another one is left alone):

      @import "tailwindcss";
      @import "../obj/lux/lux.theme.css";
      @import "../obj/lux/lux-table.theme.css";
  -->
  <PropertyGroup>
    <LuxToolsPresent>true</LuxToolsPresent>
  </PropertyGroup>

  <Target Name="LuxToolsCopyTailwindTheme" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../staticwebassets/lux-table.theme.css"
          DestinationFolder="$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), lux))"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    The check is for the projects that need the classes of the Tools components: the ones with a PackageReference to Lux.Table, where the pages
    that use the components are, and the ones that compile Tailwind with Node (a package.json with a "tailwindcss" or "@tailwindcss/..." dependency
    key: a plugin such as prettier-plugin-tailwindcss does not count), whatever they reference. A host that only reaches the package through the
    project that references it has no components of its own and compiles no Tailwind: it has nothing to say there, so it needs no property.
    Not caught: a host that compiles Tailwind another way (not Node, not LuxTailwind) and only reaches the package through another project.
  -->
  <Target Name="LuxToolsCheckTailwind" BeforeTargets="BeforeBuild" Condition="'$(LuxTailwind)' != 'true' And '$(LuxToolsOwnTailwind)' != 'true' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_LuxToolsReferenced Condition="'@(PackageReference->WithMetadataValue('Identity', 'Lux.Table'))' != ''">true</_LuxToolsReferenced>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)/package.json')">
      <_LuxToolsNodeTailwind Condition="$([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/package.json')), '&quot;(tailwindcss|@tailwindcss/[^&quot;]+)&quot;\s*:'))">true</_LuxToolsNodeTailwind>
    </PropertyGroup>
    <Warning Condition="'$(_LuxToolsReferenced)' == 'true' Or '$(_LuxToolsNodeTailwind)' == 'true'"
             Code="LUXTOOLS001"
             Text="$(MSBuildProjectName) uses Lux.Table, which has no precompiled stylesheet and needs Tailwind compiled by the app. Set &lt;LuxTailwind&gt;true&lt;/LuxTailwind&gt; (Node-free build, nothing else to do), or, if the app compiles Tailwind itself, import obj/lux/lux-table.theme.css after obj/lux/lux.theme.css in your stylesheet and set &lt;LuxToolsOwnTailwind&gt;true&lt;/LuxToolsOwnTailwind&gt; to silence this warning." />
  </Target>
</Project>
