@namespace Lux.Table
@inherits LxToolsComponentBase

@* The question an action asks before it runs. Cancel and the confirm button close the dialog without a round trip (data-lx-close); the confirm button also runs the action. *@
<LxModal Open="Open" OpenChanged="OpenChanged" Title="@Title" Description="@Description" data-slot="action-dialog">
    <Footer>
        <LxButton Label="@ToolsMessages.ActionCancel" Variant="ButtonVariant.Ghost" Color="LxColor.Neutral" data-lx-close data-slot="action-cancel" />
        <LxButton Label="@ConfirmLabel" Color="Color" OnClick="OnConfirm" data-lx-close data-slot="action-confirm" />
    </Footer>
</LxModal>

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Description { get; set; }

    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = "";

    [Parameter] public LxColor Color { get; set; }

    [Parameter] public EventCallback OnConfirm { get; set; }
}
