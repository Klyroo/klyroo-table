<Project>
  <!--
    Version lockstep: the Klyroo packages are released together, in one version, and only work with the same version of each other.
    A ProjectReference is packed as a dependency with a minimum version ([1.2.3, )); this makes it exact ([1.2.3]) for every project
    reference of the project that imports this file. 
  -->
  <Target Name="KlyrooExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>
</Project>
