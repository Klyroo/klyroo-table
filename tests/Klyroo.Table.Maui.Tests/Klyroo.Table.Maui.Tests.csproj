<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs on the plain framework target of Klyroo.Table.Maui: the state, the style tables and the parts of the data list, with no device. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Klyroo.Table.Maui\Klyroo.Table.Maui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Klyroo.Query" />
    <Using Include="Klyroo.Table" />
    <Using Include="Klyroo.Table.Maui" />
    <Using Include="Klyroo.UI.Maui" />
    <Using Include="Microsoft.Maui" />
    <Using Include="Microsoft.Maui.Controls" />
    <Using Include="Microsoft.Maui.Graphics" />
  </ItemGroup>

</Project>
